{
  "name": "street-explorer",
  "version": "0.23.12",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "postinstall": "node scripts/patch-react-native-maps-poi-filter.js",
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:country-pack-manifest": "node scripts/country-packs/build-downloadable-manifest.mjs",
    "build:country-pack-report": "node scripts/country-packs/build-wave-report.mjs",
    "test:medals": "node scripts/test-medal-enclosures.js",
    "test:country-packs": "node scripts/test-country-packs.mjs",
    "test:backup": "node scripts/test-backup-v5.js",
    "test:gpx": "node scripts/test-gpx-export.js",
    "test:expeditions": "node scripts/test-district-expeditions.js",
    "test:docs": "node scripts/test-doc-consistency.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:geometry": "node scripts/test-exploration-geometry.js",
    "test:ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-ui-polish.mjs",
    "test:wikipedia": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-wikipedia-reader.mjs",
    "test:zones": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-zone-boundary-recovery.mjs",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:sim": "eas build --platform ios --profile development-simulator",
    "test:player": "node scripts/test-player-marker.js"
  },
  "dependencies": {
    "@expo/vector-icons": "latest",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "latest"
  }
}
